[{"id":"Q1760520","n":"Khao Sok","c":"nature","k":"national park","s":56,"p":[98.5303,8.9367],"hi":"खाओ सोक राष्ट्रीय उद्यान","d":"National park in Surat Thani, Thailand","x":"Khao Sok National Park is in Surat Thani Province, Thailand. Its area is 461,712 rai ~ 739 square kilometres, and it includes the 165 km2 Cheow Lan Lake contained by the Ratchaprapha Dam. The park is the largest area of virgin forest in southern Thailand and is a remnant of rain forest which is older and more diverse than the Amazon rainforest.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/1022_KhaoSokNationalPark_2.jpg/500px-1022_KhaoSokNationalPark_2.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":319,"by":"BerryJ","lic":"CC BY-SA 4.0","src":"https://commons.wikimedia.org/wiki/File:1022_KhaoSokNationalPark_2.jpg"},"wp":"Khao Sok National Park"},{"id":"Q1359708","n":"Kraburi River","c":"water","k":"river","s":45,"p":[98.6,10.0333],"d":"Thailand-Myanmar boundary river","x":"The Kraburi River, also Kra or Pak Chan River, is the boundary river between Thailand and Myanmar at the Kra Isthmus of the Malay Peninsula. The river has its source in the Tenasserim Hills and flows into the Andaman Sea near the Thai town of Ranong and Kawthaung, Myanmar.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Mamu%2C_Kra_Buri_District%2C_Ranong_85110%2C_Thailand_-_panoramio.jpg/500px-Mamu%2C_Kra_Buri_District%2C_Ranong_85110%2C_Thailand_-_panoramio.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":480,"by":"::::=UT=::::","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:Mamu,_Kra_Buri_District,_Ranong_85110,_Thailand_-_panoramio.jpg"},"wp":"Kraburi River"},{"id":"Q13024929","n":"Chiao Lan Lake","c":"water","k":"reservoir","s":43,"p":[98.7667,9.0],"d":"Manmade lake in Thailand","x":"Cheow Lan Lake or Rajjaprabha Dam Reservoir, is located in Khao Sok National Park in Surat Thani Province, Thailand. It is an 185-square-kilometre artificial lake, inaugurated in 1987 with the construction of Rajjaprabha Dam by the Electricity Generating Authority of Thailand as a source of electricity.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2b/Karst_landscape_of_Cheow_Lan_Lake%2C_Thailand.jpg/500px-Karst_landscape_of_Cheow_Lan_Lake%2C_Thailand.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":320,"by":"Vyacheslav Argenberg","lic":"CC BY 4.0","src":"https://commons.wikimedia.org/wiki/File:Karst_landscape_of_Cheow_Lan_Lake,_Thailand.jpg"},"wp":"Cheow Lan Lake"},{"id":"Q4385001","n":"Phuket Range","c":"terrain","k":"mountain range","s":41,"p":[98.6167,9.3417],"d":"Mountain range in Thailand","x":"The Phuket Range is a subrange of the Tenasserim Hills in the Kra Isthmus, Thailand.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Ranong_98.60435E_9.94922N.jpg/500px-Ranong_98.60435E_9.94922N.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":359,"by":"NASA","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:Ranong_98.60435E_9.94922N.jpg"},"wp":"Phuket Range"},{"id":"Q5768500","n":"Laem Son National Park","c":"nature","k":"national park","s":41,"p":[98.5167,9.2833],"d":"National park in Thailand","x":"Laem Son National Park is located in Ranong and Phangnga provinces, Thailand. It is situated 60 kilometres south of Ranong on the country's west coast, with 100 kilometres of Andaman Sea coastline, making it Thailand's longest protected shore. The marine national park is named after the pines along the cape's shore.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/%E0%B9%82%E0%B8%82%E0%B8%94%E0%B8%AB%E0%B8%B4%E0%B8%99%E0%B8%A3%E0%B8%B4%E0%B8%A1%E0%B8%AB%E0%B8%B2%E0%B8%94%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B9%81%E0%B8%AB%E0%B9%88%E0%B8%87%E0%B8%8A%E0%B8%B2%E0%B8%95%E0%B8%B4%E0%B9%81%E0%B8%AB%E0%B8%A5%E0%B8%A1%E0%B8%AA%E0%B8%99.JPG/500px-%E0%B9%82%E0%B8%82%E0%B8%94%E0%B8%AB%E0%B8%B4%E0%B8%99%E0%B8%A3%E0%B8%B4%E0%B8%A1%E0%B8%AB%E0%B8%B2%E0%B8%94%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B9%81%E0%B8%AB%E0%B9%88%E0%B8%87%E0%B8%8A%E0%B8%B2%E0%B8%95%E0%B8%B4%E0%B9%81%E0%B8%AB%E0%B8%A5%E0%B8%A1%E0%B8%AA%E0%B8%99.JPG?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":320,"by":"Kumpol 01","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:%E0%B9%82%E0%B8%82%E0%B8%94%E0%B8%AB%E0%B8%B4%E0%B8%99%E0%B8%A3%E0%B8%B4%E0%B8%A1%E0%B8%AB%E0%B8%B2%E0%B8%94%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B9%81%E0%B8%AB%E0%B9%88%E0%B8%87%E0%B8%8A%E0%B8%B2%E0%B8%95%E0%B8%B4%E0%B9%81%E0%B8%AB%E0%B8%A5%E0%B8%A1%E0%B8%AA%E0%B8%99.JPG"},"wp":"Laem Son National Park"},{"id":"Q6401839","n":"Khlong Phanom National Park","c":"nature","k":"national park","s":34,"p":[98.7,8.8667],"d":"National park in Thailand","x":"Khlong Phanom is a national park in southern Thailand, protecting 256,500 rai ~ 410 square kilometres of forests within the Phuket mountain range. It was declared a national park on November 17, 2000. The park is located in the southwest of Surat Thani Province, within the district Phanom.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Virgin_tropical_forest_in_southern_Thailand%2C_Khlong_Phanom%2C_Surat_Thani.jpg/500px-Virgin_tropical_forest_in_southern_Thailand%2C_Khlong_Phanom%2C_Surat_Thani.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":320,"by":"Vyacheslav Argenberg","lic":"CC BY 4.0","src":"https://commons.wikimedia.org/wiki/File:Virgin_tropical_forest_in_southern_Thailand,_Khlong_Phanom,_Surat_Thani.jpg"},"wp":"Khlong Phanom National Park"},{"id":"Q1071624","n":"Rajjaprabha Dam","c":"works","k":"dam","s":31,"p":[98.8068,8.9727],"d":"Dam in Ban Ta Khun District","x":"Rajjaprabha Dam or Cheow Lan Dam is a multi-purpose dam in Ban Cheow Lan, Tambon Khao Phang, Ban Ta Khun District, Surat Thani Province. Its purpose is electricity generation, irrigation, flood control, and fishing. Construction started on 9 February 1982.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Rachaprapha_Dam_-_panoramio.jpg/500px-Rachaprapha_Dam_-_panoramio.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":360,"by":"Rittigai","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:Rachaprapha_Dam_-_panoramio.jpg"},"wp":"Rajjaprabha Dam"},{"id":"Q6400441","n":"Khao Chang","c":"terrain","k":"mountain","s":30,"p":[98.5131,8.4439],"d":"Mountain in Thailand","x":"Khao Chang, is a 45 m high hill in Phang Nga Province, Thailand. It is in Phang Nga town behind city hall. Located within the compound of Wat Phra Paht Phra Chim temple, at the base of a mountain, is Phung Chang Cave, also known as 'Elephant Belly Cave.' This cave is notable for its stalactites and stalagmites formations.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Phang_Nga_City_Hall.jpg/500px-Phang_Nga_City_Hall.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":360,"by":"Oatz","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:Phang_Nga_City_Hall.jpg"},"wp":"Khao Chang"},{"id":"Q4922832","n":"Si Phang Nga National Park","c":"nature","k":"national park","s":30,"p":[98.472,9.148],"d":"National park in Thailand","x":"Si Phang Nga National Park is in Phang Nga Province in southern Thailand, covering the eastern parts of the districts Khura Buri and Takua Pa. The landscape of the park is dominated by rugged mountains covered with dipterocarp forests, similar to the Khao Sok adjoining it to the east.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%95%E0%B8%B3%E0%B8%AB%E0%B8%99%E0%B8%B1%E0%B8%87.jpg/500px-%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%95%E0%B8%B3%E0%B8%AB%E0%B8%99%E0%B8%B1%E0%B8%87.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":318,"by":"Setaphong Tantanawat","lic":"CC BY-SA 4.0","src":"https://commons.wikimedia.org/wiki/File:%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%95%E0%B8%B3%E0%B8%AB%E0%B8%99%E0%B8%B1%E0%B8%87.jpg"},"wp":"Si Phang Nga National Park"},{"id":"Q4924434","n":"Kaeng Krung National Park","c":"nature","k":"national park","s":27,"p":[98.8667,9.3],"d":"National park in Thailand","x":"Kaeng Krung National Park is a national park in southern Thailand, protecting 338,125 rai ~ 541 square kilometres of forests in the Phuket mountain range. It was declared a national park on 4 December 1991. The park is in northwest Surat Thani Province, covering area of the districts Tha Chana, Chaiya, Tha Chang, and Vibhavadi.","wp":"Kaeng Krung National Park"},{"id":"Q7709084","n":"Thahtay Kyun","c":"water","k":"island","s":26,"p":[98.5315,9.9461],"d":"Island","x":"Thahtay Island, also known as Thahtay Kyun and Son Island, is a small Burmese island within the Mergui Archipelago in the Andaman Sea. The island is directly adjacent to Ranong, a city in the south of Thailand and to Kawthaung.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/48/Thahtay_Kyun_Hotel.jpg/500px-Thahtay_Kyun_Hotel.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":270,"by":"Kyaw_Zin_Win(KT)","lic":"CC BY 4.0","src":"https://commons.wikimedia.org/wiki/File:Thahtay_Kyun_Hotel.jpg"},"wp":"Thahtay Kyun"},{"id":"Q22306728","n":"Namtok Ngao National Park","c":"nature","k":"national park","s":26,"p":[98.6277,9.8563],"d":"National park in Thailand","x":"Namtok Ngao National Park, formerly Khlong Phrao National Park, is a national park in Ranong and Chumphon provinces in Thailand. The park is home to waterfalls, tropical forests and mountains.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Ngao_waterfall_surrounded_with_rainforest.jpg/500px-Ngao_waterfall_surrounded_with_rainforest.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":343,"by":"Sucha Kittiwararat","lic":"CC BY-SA 4.0","src":"https://commons.wikimedia.org/wiki/File:Ngao_waterfall_surrounded_with_rainforest.jpg"},"wp":"Namtok Ngao National Park"},{"id":"Q25197316","n":"Lam Nam Kra Buri National Park","c":"nature","k":"national park","s":26,"p":[98.6628,10.0844],"d":"National park in Thailand","x":"Lam Nam Kra Buri National Park is a marine national park in Ranong province, Thailand. The park is home to islands, tropical forests and waterfalls.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%9B%E0%B8%B8%E0%B8%8D%E0%B8%8D%E0%B8%9A%E0%B8%B2%E0%B8%A5_%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B9%81%E0%B8%AB%E0%B9%88%E0%B8%87%E0%B8%8A%E0%B8%B2%E0%B8%95%E0%B8%B4%E0%B8%A5%E0%B8%B3%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%81%E0%B8%A3%E0%B8%B0%E0%B8%9A%E0%B8%B8%E0%B8%A3%E0%B8%B5.JPG/500px-%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%9B%E0%B8%B8%E0%B8%8D%E0%B8%8D%E0%B8%9A%E0%B8%B2%E0%B8%A5_%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B9%81%E0%B8%AB%E0%B9%88%E0%B8%87%E0%B8%8A%E0%B8%B2%E0%B8%95%E0%B8%B4%E0%B8%A5%E0%B8%B3%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%81%E0%B8%A3%E0%B8%B0%E0%B8%9A%E0%B8%B8%E0%B8%A3%E0%B8%B5.JPG?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":314,"by":"attaponlim","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%9B%E0%B8%B8%E0%B8%8D%E0%B8%8D%E0%B8%9A%E0%B8%B2%E0%B8%A5_%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B9%81%E0%B8%AB%E0%B9%88%E0%B8%87%E0%B8%8A%E0%B8%B2%E0%B8%95%E0%B8%B4%E0%B8%A5%E0%B8%B3%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%81%E0%B8%A3%E0%B8%B0%E0%B8%9A%E0%B8%B8%E0%B8%A3%E0%B8%B5.JPG"},"wp":"Lam Nam Kra Buri National Park"},{"id":"Q7395479","n":"Sa Nang Manora Forest Park","c":"nature","k":"protected area","s":21,"p":[98.5422,8.5106],"d":"Protected area in southern Thailand","x":"Sa Nang Manora is a forest park in southern Thailand. It covers an area of 0.29 km2 of the Khao Thoi-Nang Hong Forest, Nop Pring Sub-district, Mueang District, Phang Nga Province, about four km north of Phang Nga town. It was established on 15 September 1980.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Sa_Nang_Manora6.jpg/500px-Sa_Nang_Manora6.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":360,"by":"Юрочкин Роман","lic":"CC BY-SA 4.0","src":"https://commons.wikimedia.org/wiki/File:Sa_Nang_Manora6.jpg"},"wp":"Sa Nang Manora Forest Park"},{"id":"Q6400446","n":"Khao Nom Sao","c":"terrain","k":"mountain","s":21,"p":[98.6517,9.8],"d":"Mountain in Thailand","x":"Khao Nom Sao, 'female breast mountain', is a mountain in Ranong province, Thailand.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Ranong_98.60435E_9.94922N.jpg/500px-Ranong_98.60435E_9.94922N.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":359,"by":"NASA","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:Ranong_98.60435E_9.94922N.jpg"},"wp":"Khao Nom Sao"},{"id":"Q6401841","n":"Khlong Saeng Wildlife Sanctuary","c":"nature","k":"nature reserve","s":21,"p":[98.5833,9.1667],"d":"Wildlife sanctuary in Thailand","x":"Khlong Saeng is a wildlife sanctuary in southern Thailand, in western Surat Thani Province. The wildlife sanctuary is named after the river Saeng, a tributary of the Phum Duang River.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Maned_Forest_Lizard_%28Bronchocela_jubata%29%3F_%2816322455876%29.jpg/500px-Maned_Forest_Lizard_%28Bronchocela_jubata%29%3F_%2816322455876%29.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":319,"by":"Pavel Kirillov from St.Petersburg, Russia","lic":"CC BY-SA 2.0","src":"https://commons.wikimedia.org/wiki/File:Maned_Forest_Lizard_(Bronchocela_jubata)%3F_(16322455876).jpg"},"wp":"Khlong Saeng Wildlife Sanctuary"},{"id":"Q6656224","n":"Khlong Yan Wildlife Sanctuary","c":"nature","k":"nature reserve","s":21,"p":[98.82,9.148],"d":"Wildlife sanctuary in Thailand","x":"Khlong Yan is a wildlife sanctuary in southern Thailand, located in the west of Surat Thani Province. It is located between the Khao Sok and Kaeng Krung National Park within the hills of the Phuket mountain range.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/%E0%B8%A0%E0%B8%B2%E0%B8%9E%E0%B8%84%E0%B8%A5%E0%B8%AD%E0%B8%87%E0%B8%A2%E0%B8%B1%E0%B8%99.jpg/500px-%E0%B8%A0%E0%B8%B2%E0%B8%9E%E0%B8%84%E0%B8%A5%E0%B8%AD%E0%B8%87%E0%B8%A2%E0%B8%B1%E0%B8%99.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":360,"by":"Eirioo1234","lic":"CC0","src":"https://commons.wikimedia.org/wiki/File:%E0%B8%A0%E0%B8%B2%E0%B8%9E%E0%B8%84%E0%B8%A5%E0%B8%AD%E0%B8%87%E0%B8%A2%E0%B8%B1%E0%B8%99.jpg"},"wp":"Khlong Yan Wildlife Sanctuary"},{"id":"Q587560","n":"Ranong Airport","c":"works","k":"airport","s":19,"p":[98.5853,9.7775],"d":"Airport in southern Thailand","x":"Ranong Airport is in Ratchakrut subdistrict, Mueang Ranong district, Ranong province in southern Thailand.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/%E0%B8%97%E0%B9%88%E0%B8%B2%E0%B8%AD%E0%B8%B2%E0%B8%81%E0%B8%B2%E0%B8%A8%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%AD%E0%B8%87_-_panoramio.jpg/500px-%E0%B8%97%E0%B9%88%E0%B8%B2%E0%B8%AD%E0%B8%B2%E0%B8%81%E0%B8%B2%E0%B8%A8%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%AD%E0%B8%87_-_panoramio.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":360,"by":"::::=UT=::::","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:%E0%B8%97%E0%B9%88%E0%B8%B2%E0%B8%AD%E0%B8%B2%E0%B8%81%E0%B8%B2%E0%B8%A8%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%AD%E0%B8%87_-_panoramio.jpg"},"wp":"Ranong Airport"},{"id":"Q6401838","n":"Khlong Phraya Wildlife Sanctuary","c":"nature","k":"nature reserve","s":17,"p":[98.9667,8.4167],"d":"Wildlife sanctuary in southern Thailand","x":"Khlong Phraya is a wildlife sanctuary in southern Thailand, at the boundary of Surat Thani and Krabi Provinces.","wp":"Khlong Phraya Wildlife Sanctuary"},{"id":"Q1321687","n":"Kawthaung Airport","c":"works","k":"airport","s":14,"p":[98.538,10.0493],"d":"Airport in Kawthaung, Myanmar","x":"Kawthaung Airport (Burmese: ကော့သောင် လေဆိပ်;) is an airport in Kawthaung, Myanmar. The airport has a very small terminal with no gates. The airport has an 1,800 by 50 metres runway.","wp":"Kawthaung Airport"},{"id":"Q30318602","n":"Bokpyin Airport","c":"works","k":"airport","s":12,"p":[98.7355,11.1511],"d":"airport located at Bokpyin, Taninthayi Region, Myanmar","x":"This is a list of airports in Myanmar, grouped by type and sorted by location. Due to the impact of the Myanmar civil war, many airports have suspended operations.","img":{"u":"https://upload.wikimedia.org/wikipedia/commons/2/26/Burma-CIA_WFB_Map.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","w":480,"h":1045,"by":"United States Central Intelligence Agency","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:Burma-CIA_WFB_Map.png"},"wp":"Bokpyin Airport"},{"id":"Q7820692","n":"Ton Pariwat Wildlife Sanctuary","c":"nature","k":"nature reserve","s":10,"p":[98.5667,8.7333],"d":"Wildlife Sanctuary","x":"The Ton Pariwat Wildlife Sanctuary is located in the north of Mueang Phang Nga district, Phang Nga Province, southern Thailand. It covers an area of 224 square kilometres of forested hills at the southern end of the Phuket mountain range.","wp":"Ton Pariwat Wildlife Sanctuary"}]