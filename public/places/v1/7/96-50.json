[{"id":"Q4986803","n":"Bukadaban Feng","c":"terrain","k":"mountain","s":43,"p":[90.8658,36.0242],"d":"Mountain in Xinjiang and Qinghai, China","x":"Bukadaban Feng or Buka Daban Feng, Syn Qing Feng or Bokalik Tagh, is a remote peak on the border between Ruoqiang County, Xinjiang and Qinghai province of China. The Chinese term 'Bukadaban Feng' is borrowed from the Uyghur for \"bison peak\". It is part of the Kunlun Mountains of East-Central Asia.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/%E5%8F%AF%E5%8F%AF%E8%A5%BF%E9%87%8C.%E5%B8%83%E5%96%80%E8%BE%BE%E5%9D%82%E5%B3%B0_-_panoramio.jpg/500px-%E5%8F%AF%E5%8F%AF%E8%A5%BF%E9%87%8C.%E5%B8%83%E5%96%80%E8%BE%BE%E5%9D%82%E5%B3%B0_-_panoramio.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":308,"by":"飘一歌-","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:%E5%8F%AF%E5%8F%AF%E8%A5%BF%E9%87%8C.%E5%B8%83%E5%96%80%E8%BE%BE%E5%9D%82%E5%B3%B0_-_panoramio.jpg"},"wp":"Bukadaban Feng"},{"id":"Q1559022","n":"Hoh Xil Shan","c":"terrain","k":"mountain range","s":38,"p":[91.0094,35.3412],"d":"mountain range","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Hoh_Xil.jpg/500px-Hoh_Xil.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":320,"by":"始见 (Archived)","lic":"CC BY 2.5 cn","src":"https://commons.wikimedia.org/wiki/File:Hoh_Xil.jpg"}},{"id":"Q1089460","n":"Chumar River","c":"water","k":"river","s":33,"p":[91.4167,35.4667],"d":"river in the People's Republic of China","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Qumar_he.jpg/500px-Qumar_he.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":320,"by":"B_cool","lic":"CC BY 2.0","src":"https://commons.wikimedia.org/wiki/File:Qumar_he.jpg"}},{"id":"Q1722129","n":"Bukaluk Tag","c":"terrain","k":"mountain range","s":29,"p":[92.4,36.0],"img":{"u":"https://thumb.wikimedia.org/wikipedia/commo