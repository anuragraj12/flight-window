[{"id":"Q2295035","n":"Naifaru","c":"water","k":"island","s":67,"p":[73.3657,5.4444],"d":"Inhabited island in Maldives","x":"Naifaru is an island in the Maldives 144 km north of the capital, Malé. It is the capital and most populous island of Lhaviyani Atoll.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/Naifaru_Town.jpg/500px-Naifaru_Town.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":300,"by":"Haflaa at Wikipedia","lic":"CC BY 4.0","src":"https://commons.wikimedia.org/wiki/File:Naifaru_Town.jpg"},"wp":"Naifaru"},{"id":"Q2178412","n":"Dharavandhoo","c":"water","k":"island","s":54,"p":[73.1306,5.1583],"d":"Island of the Maldives","x":"Dharavandhoo is one of the inhabited islands of Baa Atoll.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a6/Dharavandhoo_Aerial_View.jpg/500px-Dharavandhoo_Aerial_View.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":202,"by":"Shiyam ElkCloner","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:Dharavandhoo_Aerial_View.jpg"},"wp":"Dharavandhoo"},{"id":"Q2319970","n":"Kamadhoo","c":"water","k":"island","s":50,"p":[73.1361,5.2831],"d":"Inhabited island in Maldives","x":"Kamadhoo is one of the inhabited islands of Baa Atoll.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Baa_Atoll.png/500px-Baa_Atoll.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":477,"by":"Map originally vector'ed by Hassan Waheed, Aabaadhuge of Thinadhoo island.. Note","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:Baa_Atoll.png"},"wp":"Kamadhoo"},{"id":"Q3493388","n":"Hinnavaru","c":"water","k":"island","s":50,"p":[73.4128,5.4931],"d":"Inhabited island in Maldives","x":"Hinnavaru is one of the inhabited islands of Lhaviyani Atoll. The island has a population of more than 5000 people.","wp":"Hinnavaru"},{"id":"Q1435756","n":"Reethi Beach","c":"water","k":"island","s":45,"p":[73.1633,5.2556],"d":"Holiday island resort in Maldives","x":"Fonimagoodhoo, often called Reethi Beach is an island in the Baa Atoll in the Maldives. On the island is the Reethi Beach resort.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Reethi_Beach_Maldives.jpg/500px-Reethi_Beach_Maldives.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":360,"by":"Michael Hobi","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:Reethi_Beach_Maldives.jpg"},"wp":"Reethi Beach"},{"id":"Q2946610","n":"Kihaadhoo","c":"water","k":"island","s":45,"p":[73.125,5.2156],"d":"Island in Maalhosmadulu Dhekunuburi, Maldives","x":"Kihaadhoo is one of the inhabited islands of Baa Atoll.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Kihaadhooview.jpg/500px-Kihaadhooview.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":360,"by":"Nac m","lic":"CC BY 3.0","src":"https://commons.wikimedia.org/wiki/File:Kihaadhooview.jpg"},"wp":"Kihaadhoo"},{"id":"Q1822993","n":"Maafilaafushi","c":"water","k":"island","s":37,"p":[73.4197,5.3625],"d":"Inhabited island in Maldives","x":"Maafilaafushi is one of the uninhabited islands of Lhaviyani Atoll in the Maldives.","wp":"Maafilaafushi"},{"id":"Q4176565","n":"Olhuvelifushi","c":"water","k":"island","s":37,"p":[73.6058,5.2775],"d":"Inhabited island in Maldives","x":"Olhuvelifushi is one of the inhabited islands of Lhaviyani Atoll.","wp":"Olhuvelifushi"},{"id":"Q5269175","n":"Dharavandhoo Airport","c":"works","k":"airport","s":36,"p":[73.1306,5.1567],"d":"Airport in the Maldives","x":"Dharavandhoo Airport is a domestic airport located on the island of Dharavandhoo, part of the Baa Atoll in Maldives. It was opened on 17 October 2012 by President Mohamed Waheed Hassan. Flight operations began to the airport on 15th of that month.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/Dharavandhoo_Airport_Terminal.jpg/500px-Dharavandhoo_Airport_Terminal.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":320,"by":"Inspirationqs","lic":"CC BY-SA 4.0","src":"https://commons.wikimedia.org/wiki/File:Dharavandhoo_Airport_Terminal.jpg"},"wp":"Dharavandhoo Airport"},{"id":"Q4176474","n":"Kurendhoo","c":"water","k":"island","s":33,"p":[73.4639,5.3339],"d":"Inhabited island in Maldives","x":"Kurendhoo is one of the inhabited islands of Lhaviyani Atoll, Maldives.","wp":"Kurendhoo"},{"id":"Q2177240","n":"Komandoo","c":"water","k":"island","s":31,"p":[73.4242,5.494],"d":"Resort island in Maldives","x":"Komandoo is one of the resort islands of the Lhaviyani Atoll in the Maldives. The hotel is officially rated four stars and accommodates a maximum of 130 guests in 65 beach and ocean villas.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Komandoo_%28Lhaviyani_Atoll%29.jpg/500px-Komandoo_%28Lhaviyani_Atoll%29.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":299,"by":"eNil from Portsmouth, UK","lic":"CC BY 2.0","src":"https://commons.wikimedia.org/wiki/File:Komandoo_(Lhaviyani_Atoll).jpg"},"wp":"Komandoo (Lhaviyani Atoll)"},{"id":"Q2207843","n":"Faadhippolhu Atoll","c":"water","k":"island","s":31,"p":[73.5,5.3333],"d":"Atoll in Maldives","x":"Lhaviyani Atoll is an administrative division of the Maldives. Its abbreviation is Lh. Lhaviyani Atoll is located between 5° 15\" and 5° 35\" N and between 73° 20\" and 74° 40\" E. The capital of the atoll is Naifaru.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Lhaviyani_Atoll.png/500px-Lhaviyani_Atoll.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":562,"by":"helix84","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:Lhaviyani_Atoll.png"},"wp":"Faadhippolhu Atoll"},{"id":"Q5245869","n":"Kanifushi","c":"water","k":"island","s":23,"p":[73.3362,5.3645],"d":"Lighthouse","x":"Kanifushi Island is situated in the Lhaviyani Atoll, Maldives. Kanifushi is one of the few resort islands in Laviyani Atoll; the resort started operation on 15 December 2013, managed and operated by Atmosphere Hotels & Resorts.","wp":"Kanifushi (Lhaviyani Atoll)"},{"id":"Q110938125","n":"Madivaru Airport","c":"works","k":"airport","s":18,"p":[73.3701,5.4574],"d":"Airport in Lhaviyani Atoll, Maldives","x":"Madivaru Airport is an airport on Madivaru, Lhaviyani Atoll, Maldives. The island was previously used for military training. In May 2018 the government contracted Kuredu Holdings to develop an airport.","wp":"Madivaru Airport"}]