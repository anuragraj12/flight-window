[{"id":"Q682334","n":"Altyn-Tagh","c":"terrain","k":"mountain range","s":67,"p":[87.3891,37.9134],"d":"Mountain range","x":"Altyn-Tagh, also called the Altun Mountains, is a mountain range in northwestern China that separates the eastern Tarim Basin from the Tibetan Plateau. The western third is wholly within Xinjiang, while the eastern part forms the border between Qinghai to the south, and Xinjiang and Gansu to the north. Altun Shan, i.e.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/Altai%2C_Tienschan-Orte.png/500px-Altai%2C_Tienschan-Orte.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":343,"by":"Unknown","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:Altai,_Tienschan-Orte.png"},"wp":"Altyn-Tagh"},{"id":"Q2380766","n":"Qiemo River","c":"water","k":"river","s":53,"p":[87.2578,37.5745],"d":"River in Xinjiang, China","x":"The Qiemo River, also called the Cherchen or Qarqan River, runs across the Tarim Basin in the Xinjiang Uyghur Autonomous Region. It feeds into the Lop Nor salty marshes and the Taitema Lake.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/db/%E4%B8%AD%E5%9B%BD%E6%96%B0%E7%96%86%E4%B8%94%E6%9C%AB%E5%8E%BFChina_Xinjiang_%E4%B8%94%E6%9C%ABCounty_%E5%A4%A7%E8%84%9A%E5%8D%B0%E6%8E%A2%E9%99%A9%E6%95%91%E6%8F%B4%EF%BC%81_-_panoramio.jpg/500px-%E4%B8%AD%E5%9B%BD%E6%96%B0%E7%96%86%E4%B8%94%E6%9C%AB%E5%8E%BFChina_Xinjiang_%E4%B8%94%E6%9C%ABCounty_%E5%A4%A7%E8%84%9A%E5%8D%B0%E6%8E%A2%E9%99%A9%E6%95%91%E6%8F%B4%EF%BC%81_-_panoramio.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":319,"by":"罗布泊","lic":"CC BY 3.0","src":"https://commons.wikimedia.org/wiki/File:%E4%B8%AD%E5%9B%BD%E6%96%B0%E7%96%86%E4%B8%94%E6%9C%AB%E5%8E%BFChina_Xinjiang_%E4%B8%94%E6%9C%ABCounty_%E5%A4%A7%E8%84%9A%E5%8D%B0%E6%8E%A2%E9%99%A9%E6%95%91%E6%8F%B4%EF%BC%81_-_panoramio.jpg"},"wp":"Qiemo River"},{"id":"Q631714","n":"Lake Ayakkum","c":"water","k":"lake","s":39,"p":[89.3833,37.55],"d":"Lake in China","x":"Ayakkum Lake is a lake near the northern boundary of the Tibetan Plateau, to the southeast of the Kunlun Mountains. While many of the small glacier and snowmelt-fed streams on the Plateau give rise to major South-east Asian rivers, some empty into saline lakes such as Lake Ayakkum.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/River_Deltas%2C_Lake_Ayakum%2C_Tibet.JPG/500px-River_Deltas%2C_Lake_Ayakum%2C_Tibet.JPG?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":319,"by":"ISS Expedition 27 crew","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:River_Deltas,_Lake_Ayakum,_Tibet.JPG"},"wp":"Lake Ayakkum"},{"id":"Q16936775","n":"Lake Aqqikkol","c":"water","k":"lake","s":34,"p":[88.4,37.0833],"d":"Saline lake in Xinjiang China","x":"Lake Aqqikkol is a saline lake in Xinjiang, China. The lake falls within the borders of Ruoqiang County, and is noted as being a gathering place for local and migratory birds.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Lake_Aqqikkol_2021-07-11_Sentinel-2_L2A_True_color.jpg/500px-Lake_Aqqikkol_2021-07-11_Sentinel-2_L2A_True_color.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":370,"by":"European Space Agency","lic":"Attribution","src":"https://commons.wikimedia.org/wiki/File:Lake_Aqqikkol_2021-07-11_Sentinel-2_L2A_True_color.jpg"},"wp":"Lake Aqqikkol"},{"id":"Q18119019","n":"Sulamutag Feng","c":"terrain","k":"mountain","s":17,"p":[87.3892,37.9133],"d":"Mountain in Xinjiang, China","x":"Sulamutag Feng is a mountain located in Xinjiang, China. It is an ultra-prominent peak and is the 193rd highest in Asia. It has an elevation of 6,245 m.","wp":"Sulamutag Feng"}]