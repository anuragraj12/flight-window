[{"id":"Q1493437","n":"Gangdise Shan","c":"terrain","k":"mountain range","s":74,"p":[84.6097,29.8325],"d":"Mountain range on the Tibetan Plateau","x":"The Kailash Range,, is a mountain range on the Tibetan Plateau of Tibet Autonomous Region of China.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Tibet_Karte_Topograpisch.png/500px-Tibet_Karte_Topograpisch.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":324,"by":"Lencer","lic":"CC BY-SA 3.0","src":"https://commons.wikimedia.org/wiki/File:Tibet_Karte_Topograpisch.png"},"wp":"Gangdise Shan"},{"id":"Q659377","n":"Tangra Yumco","c":"water","k":"lake","s":67,"p":[86.5667,31.0],"d":"Salt lake in Tibet","x":"Tangra Yumco is a salt lake in Tibet, China. It is in the southwest of Nyima County. Tangra Yumco is 835.8 square kilometres, with a drainage area of 8,219.7 square kilometres, an elevation of 4,528 metres, length 71.7 kilometres and mean width 11.65 kilometres.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Satellite_Image_of_Tangra_Yumco.png/500px-Satellite_Image_of_Tangra_Yumco.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":547,"by":"NASA","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:Satellite_Image_of_Tangra_Yumco.png"},"wp":"Tangra Yumco"},{"id":"Q568223","n":"Semo La","c":"terrain","k":"mountain pass","s":61,"p":[85.4317,30.11],"d":"Mountain pass in Tibet, China","x":"Semo La is a mountain pass situated in Coqên County, Ngari Prefecture in the central part of Tibet and gives access to the Changtang region. It is found on the so-called Northern Route, north of Raka and south of Town of Coqên in Central Tibet.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Semo-la.jpg/500px-Semo-la.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":350,"by":"V.Steuer","lic":"CC BY-SA 4.0","src":"https://commons.wikimedia.org/wiki/File:Semo-la.jpg"},"wp":"Semo La"},{"id":"Q2214658","n":"Zhari Namco","c":"water","k":"lake","s":58,"p":[85.6333,30.9167],"d":"Lake in Tibet","x":"Zhari Namco or Zhari Nanmu or Lake Trari Nam is a salt lake in Tibet, China. It is bounded on the west by Coqên County of Ngari Prefecture, and on the east by Ngamring County of Shigatse Prefecture.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3e/Satellite_Image_of_Zhari_Namco.png/500px-Satellite_Image_of_Zhari_Namco.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":300,"by":"NASA","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:Satellite_Image_of_Zhari_Namco.png"},"wp":"Zhari Namco"},{"id":"Q8536063","n":"Lunpo Gangri","c":"terrain","k":"mountain","s":54,"p":[84.6133,29.8333],"d":"Mountain in Tibet, China","x":"Lunpo Gangri, also known as Loinbo Kangri, is a Himalayan mountain in Shigatse Prefecture, Tibet Autonomous Region, China. It has an elevation of 7,095 metres and is the highest peak in the Gangdise range.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/ISS064-E-12588_-_View_of_China_-_Loinbo_Kangri_ridge_near_of_Ru%27gyog_%28Ro%27gyog_Township%29_-_Glaciers_and_valleys_in_Transhimalaya_%28cropped%29.jpg/500px-ISS064-E-12588_-_View_of_China_-_Loinbo_Kangri_ridge_near_of_Ru%27gyog_%28Ro%27gyog_Township%29_-_Glaciers_and_valleys_in_Transhimalaya_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":356,"by":"Earth Science and Remote Sensing Unit, NASA Johnson Space Center","lic":"Public domain","src":"https://commons.wikimedia.org/wiki/File:ISS064-E-12588_-_View_of_China_-_Loinbo_Kangri_ridge_near_of_Ru%27gyog_(Ro%27gyog_Township)_-_Glaciers_and_valleys_in_Transhimalaya_(cropped).jpg"},"wp":"Lunpo Gangri"},{"id":"Q6192216","n":"Jiesa Lake","c":"water","k":"lake","s":45,"p":[84.7922,30.2261],"d":"Freshwater lake in Tibet Autonomous Region, China","x":"Jiesa Lake or Gyesar Tso is a lake in Coqên County in the Ngari Prefecture of the Tibet Autonomous Region of China.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Jiesa_Lake_2021-10-27_Sentinel-2_L2A_True_color.jpg/500px-Jiesa_Lake_2021-10-27_Sentinel-2_L2A_True_color.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":637,"by":"European Space Agency","lic":"Attribution","src":"https://commons.wikimedia.org/wiki/File:Jiesa_Lake_2021-10-27_Sentinel-2_L2A_True_color.jpg"},"wp":"Jiesa Lake"},{"id":"Q5242260","n":"Dawa Co","c":"water","k":"lake","s":45,"p":[84.9542,31.2444],"d":"Salt lake in Tibet Autonomous Region, China","x":"Dawa, or Dawacuo, is a lake in Coqên County in the Ngari Prefecture of the Tibet Autonomous Region of China. It is located several kilometres northwest of Coqên Town. Daxiong is a village located beyond its northeastern bank.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Dawa_Lake_2021-08-18_Sentinel-2_L2A_True_color.jpg/500px-Dawa_Lake_2021-08-18_Sentinel-2_L2A_True_color.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":433,"by":"European Space Agency","lic":"Attribution","src":"https://commons.wikimedia.org/wiki/File:Dawa_Lake_2021-08-18_Sentinel-2_L2A_True_color.jpg"},"wp":"Dawa Lake"},{"id":"Q5209873","n":"Daggyai Co","c":"water","k":"lake","s":39,"p":[85.7317,29.8428],"d":"Salt lake in Tibet Autonomous Region, China","x":"Dajia Lake or Tak Kyel Tso, is a lake in Saga County in the Shigatse Prefecture of the Tibet Autonomous Region of China. It is located about halfway between Lake Peiku and Zhari Namco, northeast of Saga.","img":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Dajia_Lake_2022-10-17_Sentinel-2_L2A_True_color.jpg/500px-Dajia_Lake_2022-10-17_Sentinel-2_L2A_True_color.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","w":480,"h":572,"by":"European Space Agency","lic":"Attribution","src":"https://commons.wikimedia.org/wiki/File:Dajia_Lake_2022-10-17_Sentinel-2_L2A_True_color.jpg"},"wp":"Dajia Lake"}]